{
  "name": "orgwright",
  "version": "1.0.0",
  "description": "Write Salesforce tests in plain English, get real Playwright code.",
  "main": "index.js",
  "scripts": {
    "setup": "npm install && pnpm --dir orgwright install && pnpm --dir orgwright -r run build",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:notes": "playwright test tests/rcm-notes-sync.spec.ts",
    "test:regression": "playwright test tests/generated/ --project=salesforce",
    "test:regression:headed": "playwright test tests/generated/ --project=salesforce --headed",
    "test:report": "playwright show-report",
    "auth:refresh": "playwright test tests/auth.setup.ts --project=setup",
    "studio": "pnpm --prefix orgwright --filter @orgwright/studio start",
    "studio:server": "pnpm --prefix orgwright --filter @orgwright/studio run server",
    "studio:ui": "pnpm --prefix orgwright --filter @orgwright/studio run dev",
    "orgwright:build": "pnpm --prefix orgwright -r run build",
    "suite:nightly": "pnpm --prefix orgwright --filter @orgwright/studio exec tsx server/cli/run-suite.ts",
    "test:helpers": "playwright test -c tests-orgwright/playwright.unit.config.ts",
    "test:parser": "node --test \"orgwright/packages/resolver/test/*.test.mjs\"",
    "fixture:capture": "npx tsx tests-orgwright/capture-fixture.ts",
    "test:codegen": "node --test \"orgwright/packages/codegen/test/*.test.mjs\"",
    "test:unit": "pnpm --prefix orgwright -r run build && node --test \"orgwright/packages/resolver/test/*.test.mjs\" \"orgwright/packages/codegen/test/*.test.mjs\" && npm run test:studio",
    "test:studio": "pnpm --dir orgwright/apps/studio exec tsx --test server/test/*.test.ts"
  },
  "keywords": [
    "salesforce",
    "crm",
    "automation",
    "testing",
    "orgwright",
    "quality"
  ],
  "author": "Krishna Kumar",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "ws": "^8.22.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/krishnakumar11oct1995-star/orgwright.git"
  }
}
